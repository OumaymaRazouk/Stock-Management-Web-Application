# Examples only. Export these variables in the backend process environment.
# Spring Boot does not load .env automatically.
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=gestion_stock;encrypt=true;trustServerCertificate=true
DB_USERNAME=stock_app_example
DB_PASSWORD=REPLACE_LOCALLY
CORS_ALLOWED_ORIGINS=http://localhost:4200
AUTH_TOKEN_TTL=PT8H

# Optional first-admin bootstrap only; never needed for normal startup.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
# BOOTSTRAP_ADMIN_PASSWORD=REPLACE_LOCALLY
